# Process
NODE_ENV=production
PORT=3100
TRUST_PROXY=1
LOG_LEVEL=info
# Keep checkout closed until the renderer, webhook, and transactional email
# have all passed a production smoke test.
SALES_ENABLED=false

# Public brand and URLs
PUBLIC_API_URL=https://reports.zodiyuga.com
LANDING_BASE_URL=https://zodiyuga.com/cosmic-report
CORS_ALLOWED_ORIGINS=https://zodiyuga.com,https://www.zodiyuga.com

# Stripe — never commit real values
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COSMIC_REPORT_PRICE_ID=

# At least 32 random characters. Generate on the VPS, never in the repository.
DOWNLOAD_TOKEN_SECRET=

# Report engine
COSMIC_REPORT_SCRIPT=/opt/zodi-yuga/current/report-engine/scripts/generate_full_report.py
COSMIC_PYTHON_BIN=/opt/zodi-yuga/venv/bin/python
COSMIC_EPHE_PATH=/opt/zodi-yuga/current/public/ephe
GENERATOR_TIMEOUT_MS=900000

# Private runtime state owned by the unprivileged zodireports service account
ORDERS_DIR=/var/lib/zodi-yuga-report-service/orders
REPORT_OUTPUT_DIR=/var/lib/zodi-yuga-report-service/reports
TMPDIR=/var/lib/zodi-yuga-report-service/tmp

# Geocoding: Mapbox is primary; Nominatim is an explicitly enabled fallback.
MAPBOX_ACCESS_TOKEN=
MAPBOX_COUNTRY_CODES=
ALLOW_NOMINATIM_FALLBACK=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ZodiYugaReportService/1.0 (https://zodiyuga.com/support/)
GEOCODE_TIMEOUT_MS=10000

# Transactional email. Authenticate zodiyuga.com with SPF, DKIM, and DMARC first.
SMTP_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Zodi Yuga Reports
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_TIMEOUT_MS=15000

# Paid-customer marketing sync. Customers are added only when they explicitly opt in.
MAILERLITE_ENABLED=false
MAILERLITE_API_KEY=
MAILERLITE_PAID_EN_GROUP_ID=
MAILERLITE_PAID_ES_GROUP_ID=
MAILERLITE_TIMEOUT_MS=10000
